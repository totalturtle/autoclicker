# 모든 텍스트 파일은 저장소에서 LF로 정규화 (CRLF/BOM 재유입 방지)
* text=auto eol=lf

# 명시적으로 텍스트 처리할 소스/리소스
*.kt    text eol=lf
*.java  text eol=lf
*.xml   text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
*.txt   text eol=lf
*.html  text eol=lf
*.md    text eol=lf
*.pro   text eol=lf

# 바이너리(정규화 금지)
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.ttf   binary
*.otf   binary
*.jks   binary
*.keystore binary
*.apk   binary
